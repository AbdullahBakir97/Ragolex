{
  "name": "ragolex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web interface for the Ragolex API.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.widget.config.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
