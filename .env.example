APP_NAME="Ragolex"
APP_VERSION="0.1"
OPENAI_API_KEY=""
LOG_LEVEL="INFO"
# "json" for one JSON object per line, for log collectors.
LOG_FORMAT="text"
# Required by GET /metrics as a bearer token when set.
# METRICS_TOKEN=""
# US dollars each tenant's answers may cost per month (needs the LLM_*_PRICE_PER_MILLION prices).
# BUDGET_USD_PER_MONTH=0

# Website sources: let crawls reach localhost and private networks (an intranet).
# CRAWLER_ALLOW_PRIVATE_URLS=false

# Malware scanning of uploads with ClamAV, e.g. "tcp://clamav:3310" with
# `docker compose --profile scan up`. Unset, uploads are not scanned.
# CLAMAV_URL=""

# Embeddings: OpenAI by default. For a local OpenAI-compatible server such as
# Ollama, set EMBEDDING_BASE_URL ("http://host.docker.internal:11434/v1" with
# Docker, "http://localhost:11434/v1" without) and the length of the model's
# vectors, e.g. EMBEDDING_DIMENSIONS=768 for nomic-embed-text. See
# docs/configuration.md#model-providers.
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Answer generation: OpenAI by default, using OPENAI_API_KEY. For a local
# OpenAI-compatible server such as Ollama, set LLM_BASE_URL like
# EMBEDDING_BASE_URL and a model it serves, e.g. "llama3.1". An empty
# LLM_TEMPERATURE uses the model's default.
LLM_BASE_URL=""
LLM_MODEL="gpt-4.1-mini"
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=""
# Token usage of streamed answers; set to false if your server rejects stream_options.
LLM_STREAM_USAGE=true
# The model's prices in US dollars per million tokens, for answer costs.
# Empty means unknown; use 0 for a free tier.
LLM_INPUT_PRICE_PER_MILLION=""
LLM_OUTPUT_PRICE_PER_MILLION=""
# Chunks scoring below this are not used for answers.
ANSWER_MIN_SCORE=0.3
# hybrid: chunks close in meaning or sharing the question's words; vector: meaning only.
SEARCH_MODE="hybrid"

# Optional reranking with a server that has the POST /rerank API (Cohere,
# Jina, vLLM, Infinity). Empty RERANK_BASE_URL turns it off.
RERANK_BASE_URL=""
RERANK_MODEL=""
RERANK_API_KEY=""
RERANK_CANDIDATES=20

# Require an API key on every request (create one with `ragolex keys create`).
# Off, every request acts for the tenant "default" with every scope: fine on
# your own computer, never on a server others can reach.
AUTH_ENABLED=false

# Limits per tenant; 0 is unlimited. `ragolex tenants limits` sets a tenant's own.
RATE_LIMIT_PER_MINUTE=0
ANSWERS_PER_MONTH=0
STORAGE_MB_PER_TENANT=0

# Background jobs (POST /api/v1/projects/{project}/jobs) the API runs at once;
# 0 leaves them to separate `ragolex worker` processes.
JOB_WORKERS=1
# Tries per job when the embedding provider fails, before the job fails.
JOB_MAX_ATTEMPTS=3

# Webhooks reach only public addresses; true lets them reach localhost and
# private networks (e.g. n8n in the same compose stack).
WEBHOOK_ALLOW_PRIVATE_URLS=false
WEBHOOK_TIMEOUT_SECONDS=10

# Ports on this computer for docker compose; change one when it is already in use.
# WEB_PORT=3000
# API_PORT=8000
# DB_PORT=5432

# Matches compose.yaml
DATABASE_URL="postgresql+asyncpg://ragolex:ragolex@localhost:5432/ragolex"

FILES_DIR="assets/files"
FILE_ALLOWED_TYPES=["text/plain", "text/markdown", "text/html", "application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB
